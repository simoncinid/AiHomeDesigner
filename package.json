{
  "name": "ai-homedesigner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && echo 'API build handled by Render'",
    "db:migrate": "cd apps/api && alembic upgrade head",
    "db:makemigrations": "cd apps/api && alembic revision --autogenerate -m"
  }
}
